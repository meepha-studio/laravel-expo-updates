{
    "name": "laravel-expo-updates",
    "description": "Laravel package for handling Expo Updates protocol",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "LaravelExpoUpdates\\": "src/"
        }
    },
    "require": {
        "php": "^8.1",
        "illuminate/support": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/database": "^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0",
        "phpunit/phpunit": "^10.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaravelExpoUpdates\\ExpoUpdatesServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
} 